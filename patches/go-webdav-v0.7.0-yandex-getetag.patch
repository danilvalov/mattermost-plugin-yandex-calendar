diff --git a/caldav/etag_header_test.go b/caldav/etag_header_test.go
new file mode 100644
index 0000000..f756616
--- /dev/null
+++ b/caldav/etag_header_test.go
@@ -0,0 +1,18 @@
+package caldav
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestPopulateCalendarObjectToleratesWeakETag(t *testing.T) {
+	co := &CalendarObject{}
+	h := make(http.Header)
+	h.Set("ETag", `W/"yandex-weak-etag"`)
+	if err := populateCalendarObject(co, h); err != nil {
+		t.Fatalf("populateCalendarObject: %v", err)
+	}
+	if co.ETag == "" {
+		t.Fatal("expected non-empty ETag")
+	}
+}
